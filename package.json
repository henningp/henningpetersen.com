{
  "name": "henningpetersen.com",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "node ./scripts/deploy.mjs",
    "build:background": "python3 scripts/build-background.py",
    "build:upload": "python3 scripts/build-upload.py",
    "test": "node --test tests/background.test.mjs && python3 -m unittest discover -s services/background -p 'test_*.py' && python3 -m unittest discover -s services/upload -p 'test_*.py'"
  },
  "dependencies": {
    "astro": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
