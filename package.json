{
  "name": "henningpetersen.com",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "node ./scripts/deploy.mjs",
    "build:background": "python3 scripts/build-background.py",
    "build:upload": "python3 scripts/build-upload.py",
    "build:admin": "python3 scripts/build-admin.py",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s services/background -p 'test_*.py' && python3 -m unittest discover -s services/upload -p 'test_*.py' && python3 -m unittest discover -s services/admin -p 'test_*.py'"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
