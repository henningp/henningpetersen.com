---
import { SITE } from "../config";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name}</title>
    <meta name="description" content={`${SITE.name} — ${SITE.domain}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={SITE.name} />
    <meta property="og:description" content={SITE.domain} />
    <script>
      import { getLocale } from "../locale";

      // Runs before first paint: apply persisted or auto-detected locale.
      (function () {
        const locale = getLocale();
        document.documentElement.setAttribute("data-locale", locale);
        document.documentElement.setAttribute("lang", locale);
      })();
    </script>
  </head>
  <body>
    <div class="background" aria-hidden="true">
      <img id="background-photo" alt="" decoding="async" />
      <div class="background-scrim"></div>
    </div>
    <header>
      <nav aria-label="Language" class="lang-toggle">
        <button type="button" data-choose-locale="en" aria-pressed="false">EN</button>
        <span class="lang-sep" aria-hidden="true">/</span>
        <button type="button" data-choose-locale="de" aria-pressed="false">DE</button>
      </nav>
    </header>

    <main>
      <section class="card" aria-live="polite">
        <h1>
          <span class="greeting" data-locale-content="en">Good afternoon!</span>
          <span class="greeting" data-locale-content="de" hidden>Guten Tag</span>
        </h1>

        <p data-locale-content="en">
          This domain is currently used for email only. My work website is at
          <a class="domain-link" href={SITE.companyUrl}>{SITE.companyLabel}</a>.
        </p>
        <p data-locale-content="de" hidden>
          Diese Domain wird im Moment nur für E-Mail benutzt. Meine berufliche Website findet sich unter
          <a class="domain-link" href={SITE.companyUrl}>{SITE.companyLabel}</a>.
        </p>

        <div class="actions">
          <a class="btn primary" href={SITE.companyUrl}
            ><span data-locale-content="en">Go to</span>
            <span data-locale-content="de" hidden>Zu</span>
            <span class="btn-host">{SITE.companyLabel}</span>
            <span
              aria-hidden="true"
            >&rarr;</span
          ></a>
          <a class="btn" href={`mailto:${SITE.email}`}>
            <span data-locale-content="en">Send an email</span>
            <span data-locale-content="de" hidden>E-Mail schreiben</span>
          </a>
        </div>
      </section>

      <footer>
        <details class="imprint">
          <summary>
            <span data-locale-content="en">Legal notice</span>
            <span data-locale-content="de" hidden>Impressum</span>
          </summary>
          <div class="imprint-body">
            <p data-locale-content="de" hidden>Angaben gemäß § 5 DDG:</p>
            <address>
              {SITE.name}
              <br />
              Boxhagener Str. 43
              <br />
              10245 Berlin
              <br />
              <span data-locale-content="en">Germany</span><span data-locale-content="de" hidden>Deutschland</span>
            </address>
            <p>
              <span data-locale-content="en">Email</span><span data-locale-content="de" hidden>E-Mail</span>:
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </p>
          </div>
        </details>
        <details class="imprint">
          <summary>
            <span data-locale-content="en">Privacy</span>
            <span data-locale-content="de" hidden>Datenschutz</span>
          </summary>
          <div class="imprint-body">
            <p data-locale-content="en">
              This website is hosted on AWS. When you open a page, your IP
              address is transmitted so the content can be delivered. We do not
              store IP addresses or any other visitor data; our hosting provider
              AWS acts as a data processor under its standard data processing
              agreement.
            </p>
            <p data-locale-content="de" hidden>
              Diese Website wird über AWS betrieben. Beim Öffnen einer Seite wird
              Ihre IP-Adresse übermittelt, damit die Inhalte ausgeliefert werden
              können. Wir speichern keine IP-Adressen oder sonstige Besucherdaten;
              unser Hoster AWS ist ein Auftragsverarbeiter gemäß Art. 28 DSGVO.
            </p>
            <p data-locale-content="en">
              The rotating background photographs are delivered through the same
              hosting provider, without requests to external photo services.
            </p>
            <p data-locale-content="de" hidden>
              Die wechselnden Hintergrundfotos werden über denselben Hoster
              ausgeliefert, ohne Anfragen an externe Fotodienste.
            </p>
            <p data-locale-content="en">
              Only a language choice different from your browser's default is
              saved locally for future visits. Switching back removes it.
              This preference is not sent to us.
            </p>
            <p data-locale-content="de" hidden>
              Nur eine von der Browsersprache abweichende Sprachwahl wird lokal
              für künftige Besuche gespeichert. Beim Zurückwechseln wird sie
              gelöscht. Diese Einstellung wird nicht an uns übermittelt.
            </p>
            <p data-locale-content="en">
              This site sets no cookies and uses no analytics or tracking.
            </p>
            <p data-locale-content="de" hidden>
              Diese Website setzt keine Cookies ein und verwendet keine
              Analyse- oder Trackingdienste.
            </p>
            <p data-locale-content="en">
              This is based on our legitimate interest in operating the site and
              serving the content you request (Art. 6(1)(f) GDPR). Questions
              about this or your rights:
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
            </p>
            <p data-locale-content="de" hidden>
              Rechtsgrundlage ist unser berechtigtes Interesse am Betrieb der
              Website und der Bereitstellung der von Ihnen angeforderten Inhalte
              (Art. 6 Abs. 1 lit. f DSGVO). Fragen dazu oder zu Ihren Rechten:
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
            </p>
          </div>
        </details>
      </footer>
    </main>
    <p id="background-caption" class="background-caption" hidden></p>

    <script>
      import { pickGreeting, type Locale } from "../config";
      import { getLocale, isLocale, saveLocale } from "../locale";
      import { createBackgroundCaption, createBackgroundUpdater } from "../background";

      const backgroundCaption = createBackgroundCaption(
        document.querySelector<HTMLElement>("#background-caption"), getLocale(),
      );
      const background = document.querySelector<HTMLImageElement>("#background-photo");
      if (background) {
        const updateBackground = createBackgroundUpdater(background, fetch, undefined, backgroundCaption);
        void updateBackground();
        setInterval(() => {
          if (document.visibilityState === "visible") void updateBackground();
        }, 300000);
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") void updateBackground();
        });
      }

      (function () {
        const html = document.documentElement;
        const initialLocale = html.getAttribute("data-locale");
        let activeLocale = isLocale(initialLocale) ? initialLocale : getLocale();

        function updateGreeting(locale: Locale) {
          document.querySelectorAll<HTMLElement>(".greeting").forEach(function (g) {
            if (g.getAttribute("data-locale-content") === locale)
              g.textContent = pickGreeting(locale, new Date().getHours());
          });
        }

        function applyLocale(loc: Locale) {
          activeLocale = loc;
          html.setAttribute("data-locale", loc);
          html.setAttribute("lang", loc);
          document.querySelectorAll<HTMLElement>("[data-locale-content]").forEach(function (el) {
            el.hidden = el.getAttribute("data-locale-content") !== loc;
          });
          document
            .querySelectorAll("[data-choose-locale]")
            .forEach(function (btn) {
              btn.setAttribute(
                "aria-pressed",
                String(btn.getAttribute("data-choose-locale") === loc),
              );
            });
          document.title = "Henning Petersen";

          updateGreeting(loc);
          backgroundCaption.setLocale(loc);
        }

        document.querySelectorAll("[data-choose-locale]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            const locale = btn.getAttribute("data-choose-locale");
            if (!isLocale(locale)) return;
            applyLocale(locale);
            saveLocale(locale);
          });
        });

        applyLocale(activeLocale);

        // Refresh the greeting on a light cadence so a tab left open across a
        // time boundary still shows the right one.
        setInterval(function () {
          updateGreeting(activeLocale);
        }, 60000);
      })();
    </script>

    <style>
      :root {
        --bg: #f4f5f7;
        --photo-overlay: rgb(244 245 247 / 50%);
        --card: #ffffff;
        --text: #1a1d23;
        --muted: #5c6370;
        --border: #dfe2e8;
        --accent: #1d4ed8;
        --accent-contrast: #ffffff;
        --btn-text: #1a1d23;
        --btn-border: #cfd4dc;
        --footer-underline: color-mix(in srgb, var(--text) 25%, transparent);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #101216;
          --photo-overlay: rgb(16 18 22 / 50%);
          --card: #181b21;
          --text: #e7e9ee;
          --muted: #9aa1ad;
          --border: #2a2e36;
          --accent: #6d92f5;
          --accent-contrast: #0b0d12;
          --btn-text: #e7e9ee;
          --btn-border: #3a3f4a;
          --footer-underline: var(--border);
        }
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          Arial,
          sans-serif;
        line-height: 1.6;
        color: var(--text);
        background: var(--bg);
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        isolation: isolate;
      }

      .background {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }
      .background img,
      .background-scrim {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .background img {
        object-fit: cover;
        opacity: 0;
        transition: opacity 300ms ease;
      }
      .background img.is-loaded {
        opacity: 1;
      }
      .background-scrim {
        background: var(--photo-overlay);
      }
      .background-caption {
        position: fixed;
        right: max(1rem, env(safe-area-inset-right));
        bottom: max(1rem, env(safe-area-inset-bottom));
        max-width: min(28rem, calc(100% - 2rem));
        margin: 0;
        padding: 0.3rem 0.65rem;
        border-radius: 0.4rem;
        text-shadow: 0 1px 3px rgb(0 0 0 / 80%);
        color: #fff;
        font-size: 0.75rem;
        overflow-wrap: anywhere;
      }
      /* Keep long captions out of the footer's way on small screens. */
      @media (max-width: 40rem), (max-height: 35rem) {
        .background-caption {
          position: static;
          align-self: flex-end;
          margin: 0 1rem 1rem;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .background img {
          transition: none;
        }
      }

      header {
        padding: 1rem 1.5rem 0;
      }
      /* Text outside the solid card needs full contrast over the photo. */
      .lang-toggle,
      footer {
        --muted: var(--text);
      }
      .lang-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        font-variant-numeric: tabular-nums;
      }
      .lang-toggle button {
        appearance: none;
        border: 0;
        background: transparent;
        color: var(--muted);
        font: inherit;
        padding: 0.25rem 0.5rem;
        border-radius: 0.4rem;
        cursor: pointer;
      }
      .lang-toggle button[aria-pressed="true"] {
        color: var(--text);
        font-weight: 600;
        background: color-mix(in srgb, var(--text) 8%, transparent);
      }
      .lang-toggle button:hover {
        color: var(--text);
      }
      .lang-sep {
        color: var(--muted);
        opacity: 0.6;
      }

      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        padding: 2rem 1.5rem;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 2.5rem 2.25rem;
        max-width: 28rem;
        width: 100%;
        box-shadow:
          0 1px 2px rgb(0 0 0 / 6%),
          0 12px 32px -16px rgb(0 0 0 / 12%);
      }
      .card h1 {
        margin: 0 0 0.75rem;
        font-size: 1.5rem;
        line-height: 1.25;
        letter-spacing: -0.01em;
      }
      .card p {
        margin: 0;
        color: var(--muted);
      }
      .card p a.domain-link {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .card p a.domain-link:hover {
        color: color-mix(in srgb, var(--accent), black 12%);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.75rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1rem;
        border: 1px solid var(--btn-border);
        border-radius: 0.6rem;
        color: var(--btn-text);
        text-decoration: none;
        font-size: 0.95rem;
        background: transparent;
        transition:
          background 0.15s ease,
          border-color 0.15s ease,
          transform 0.05s ease;
      }
      .btn:hover {
        border-color: var(--muted);
        background: color-mix(in srgb, var(--text) 5%, transparent);
      }
      .btn:active {
        transform: translateY(1px);
      }
      .btn-host {
        font-weight: 600;
      }
      .btn.primary {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--accent-contrast);
      }
      .btn.primary:hover {
        background: color-mix(in srgb, var(--accent), black 8%);
      }
      .btn:focus-visible,
      .card p a.domain-link:focus-visible,
      .lang-toggle button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      footer {
        padding: 0 1.5rem 2rem;
        text-align: center;
        font-size: 0.85rem;
        color: var(--muted);
      }
      footer a {
        color: var(--muted);
        text-decoration: none;
        border-bottom: 1px solid var(--footer-underline);
      }
      footer a:hover {
        color: var(--text);
      }

      footer .imprint {
        margin-top: 0.75rem;
      }
      footer .imprint > summary {
        display: inline;
        cursor: pointer;
        color: var(--muted);
        text-decoration: none;
        border-bottom: 1px solid var(--footer-underline);
        list-style: none;
      }
      footer .imprint > summary::-webkit-details-marker {
        display: none;
      }
      footer .imprint > summary:hover
      footer .imprint[open] > summary {
        color: var(--text);
      }
      footer .imprint-body {
        margin-top: 0.75rem;
      }
      footer .imprint-body address {
        font-style: normal;
      }
    </style>
  </body>
</html>
